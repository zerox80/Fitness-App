    "test:coverage:report": "vitest run --coverage --config vitest.coverage-report.config.ts",
    "test:android:coverage": "node scripts/run-android-coverage.js",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~57.0.2",
    "expo-constants": "~57.0.3",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-health-connect": "^0.1.1",
    "expo-image": "~57.0.0",
    "expo-linear-gradient": "^57.0.0",
    "expo-linking": "~57.0.1",
    "expo-router": "~57.0.3",
    "expo-secure-store": "^57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "lucide-react-native": "^1.16.0",
    "react": "19.2.3",
